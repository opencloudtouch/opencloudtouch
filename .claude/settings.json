{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github.*__(issue_write|create_issue|update_issue|update_pull_request|create_pull_request|add_issue_comment|create_issue_comment|update_issue_comment|pull_request_review_write|add_comment_to_pending_review|add_reply_to_pull_request_comment)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/oct_status/hooks/guard.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/oct_status/hooks/guard.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/oct_status/hooks/session_start.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
